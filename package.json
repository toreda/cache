{
	"name": "@toreda/cache",
	"version": "1.0.0",
	"description": "Time-based object cache in TypeScript.",
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"scripts": {
		"build": "pnpm run build:prod",
		"build:prod": "gulp --prod",
		"build:dev": "gulp --dev",
		"test": "jest --coverage --maxWorkers=50%",
		"test:fast": "jest --coverage=false --maxWorkers=50%",
		"test:ci": "jest --ci --coverage --maxWorkers=50% --silent --verbose=false",
		"test:silent": "jest --coverage=false --maxWorkers=50% --silent --verbose=false",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"make:docs": "typedoc docs --categorizeByGroup false --entryPoints ./src/index.ts",
		"make:depgraph": "madge src/index.ts --image dependency-graph.png"
	},
	"packageManager": "pnpm@10.11.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/toreda/cache.git"
	},
	"keywords": [
		"object-cache",
		"generic-cache",
		"timed-cache",
		"ttl",
		"simple-cache",
		"toreda",
		"javascript",
		"typescript"
	],
	"prettier": "@toreda/prettier-config",
	"author": "Toreda, Inc.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/toreda/cache/issues"
	},
	"homepage": "https://github.com/toreda/cache#readme",
	"devDependencies": {
		"@swc/core": "^1.15.46",
		"@swc/jest": "^0.2.39",
		"@toreda/build-tools": "^0.8.0",
		"@toreda/eslint-config": "^3.1.0",
		"@toreda/prettier-config": "^1.0.1",
		"@types/gulp": "^4.0.18",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"eslint": "^9.39.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"gulp": "^4.0.2",
		"gulp-typescript": "6.0.0-alpha.1",
		"jest": "^30.4.2",
		"jest-environment-node": "^30.4.1",
		"prettier": "^3.9.6",
		"ts-node": "^10.9.2",
		"typedoc": "^0.28.0",
		"typescript": "^5.9.0"
	},
	"dependencies": {
		"@toreda/lifecycle": "^2.2.1",
		"@toreda/log": "^0.6.16",
		"@toreda/shared-types": "^3.0.0",
		"@toreda/strong-types": "^0.28.5",
		"@toreda/time": "^0.2.0"
	},
	"pnpm": {
		"overrides": {
			"glob-parent": "^5.1.2"
		}
	}
}
